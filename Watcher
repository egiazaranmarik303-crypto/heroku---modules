# meta developer: ChatGPT

from datetime import datetime

from telethon import types

from .. import loader, utils


@loader.tds
class WatchHistoryMod(loader.Module):
    """
    WatchHistory

    Модуль ведёт локальную историю сообщений отслеживаемых чатов.

    Возможности:

    .addwtch
        Начать отслеживание текущего чата.

    .delwtch
        Остановить отслеживание текущего чата.

    .wtchlist
        Показать удалённые и отредактированные сообщения.

    .wtchhstry
        Показать сохранённую историю сообщений.

    .wtchclear
        Очистить журнал удалений и редактирований.

    Внешние зависимости НЕ нужны.
    """

    # ========================================================
    # НАЗВАНИЕ МОДУЛЯ
    # ========================================================
    #
    # Это название будет отображаться в списке модулей Heroku.
    #

    strings = {
        "name": "WatchHistory",
    }

    # ========================================================
    # НАСТРОЙКИ
    # ========================================================

    # Максимальное количество сообщений,
    # которые сохраняются для одного чата.
    #
    # Если поставить 5000, в каждом чате будут храниться
    # последние 5000 сообщений.
    #

    MAX_HISTORY = 5000

    # Максимальное количество изменений,
    # отображаемых через .wtchlist.
    #

    MAX_CHANGES = 50

    # ========================================================
    # ИНИЦИАЛИЗАЦИЯ
    # ========================================================

    async def client_ready(self, client, db):
        """
        Вызывается Heroku после загрузки модуля.

        Здесь создаём необходимые разделы базы данных.
        """

        # Telegram-клиент.
        self.client = client

        # База данных модуля.
        #
        # self.get() / self.set() позволяют сохранять
        # информацию между перезапусками.
        #

        self.db = db

        # ----------------------------------------------------
        # СПИСОК ОТСЛЕЖИВАЕМЫХ ЧАТОВ
        # ----------------------------------------------------

        # Здесь будут находиться ID чатов, например:
        #
        # [
        #     "123456789",
        #     "-1001234567890"
        # ]
        #

        if self.get("watched", None) is None:
            self.set("watched", [])

        # ----------------------------------------------------
        # АРХИВ СООБЩЕНИЙ
        # ----------------------------------------------------
        #
        # Здесь сохраняются сообщения, которые мы уже увидели.
        #
        # Это самое важное место для восстановления удалённых
        # сообщений.
        #

        if self.get("history", None) is None:
            self.set("history", {})

        # ----------------------------------------------------
        # ЖУРНАЛ ИЗМЕНЕНИЙ
        # ----------------------------------------------------
        #
        # Здесь отдельно находятся:
        #
        # deleted — удалённые сообщения
        # edited  — отредактированные сообщения
        #

        if self.get("changes", None) is None:
            self.set("changes", {})

    # ========================================================
    # ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
    # ========================================================

    def get_watched(self):
        """
        Получает список отслеживаемых чатов.
        """

        return self.get("watched", [])

    def get_history(self):
        """
        Получает архив сообщений.
        """

        return self.get("history", {})

    def get_changes(self):
        """
        Получает журнал изменений.
        """

        return self.get("changes", {})

    # ========================================================
    # ПОЛУЧЕНИЕ ИМЕНИ АВТОРА
    # ========================================================

    async def get_sender_name(self, message):
        """
        Пытается получить нормальное имя автора сообщения.

        Например:

        Иван
        Иван Петров
        @username
        """

        try:
            sender = await message.get_sender()

            if not sender:
                return "Неизвестный"

            first_name = (
                getattr(sender, "first_name", "")
                or ""
            )

            last_name = (
                getattr(sender, "last_name", "")
                or ""
            )

            username = getattr(
                sender,
                "username",
                None,
            )

            # Имя + фамилия.
            name = f"{first_name} {last_name}".strip()

            if name:
                return name

            # Если имени нет — username.
            if username:
                return f"@{username}"

            # Последний вариант — Telegram ID.
            return str(sender.id)

        except Exception:
            return "Неизвестный"

    # ========================================================
    # НОВЫЕ СООБЩЕНИЯ
    # ========================================================

    @loader.watcher()
    async def watcher(self, message):
        """
        Этот watcher получает новые сообщения.

        Например:

            Друг: Привет

        Мы сразу записываем:

            ID       → 123
            Автор    → Друг
            Текст    → Привет
            Время    → 23:51

        Если потом сообщение удалят, мы всё ещё будем
        иметь его копию в своей БД.
        """

        try:
            # У сообщения должен быть чат.
            if message.chat_id is None:
                return

            # ID текущего чата.
            chat_id = str(message.chat_id)

            # Список отслеживаемых чатов.
            watched = self.get_watched()

            # Если чат не отслеживается — выходим.
            if chat_id not in watched:
                return

            # Получаем текст сообщения.
            text = message.raw_text or ""

            # ------------------------------------------------
            # НЕ СОХРАНЯЕМ КОМАНДЫ САМОГО МОДУЛЯ
            # ------------------------------------------------

            commands = (
                ".addwtch",
                ".delwtch",
                ".wtchlist",
                ".wtchhstry",
                ".wtchclear",
            )

            if text.startswith(commands):
                return

            # Получаем имя автора.
            sender = await self.get_sender_name(message)

            # Получаем существующую историю.
            history = self.get_history()

            # Если этого чата ещё нет в БД,
            # создаём для него отдельный словарь.
            if chat_id not in history:
                history[chat_id] = {}

            # ------------------------------------------------
            # СОХРАНЯЕМ СООБЩЕНИЕ
            # ------------------------------------------------

            history[chat_id][str(message.id)] = {
                # ID сообщения.
                "id": message.id,

                # Автор сообщения.
                "sender": sender,

                # Текст сообщения.
                "text": text,

                # Время отправки.
                "date": (
                    message.date.timestamp()
                    if message.date
                    else 0
                ),
            }

            # ------------------------------------------------
            # ОГРАНИЧИВАЕМ РАЗМЕР ИСТОРИИ
            # ------------------------------------------------

            if len(history[chat_id]) > self.MAX_HISTORY:

                items = list(
                    history[chat_id].values()
                )

                # Сортируем от старых к новым.
                items.sort(
                    key=lambda x: x.get("date", 0)
                )

                # Сколько старых сообщений нужно удалить.
                excess = (
                    len(items)
                    - self.MAX_HISTORY
                )

                for old_message in items[:excess]:

                    old_id = str(
                        old_message["id"]
                    )

                    del history[
                        chat_id
                    ][old_id]

            # Сохраняем изменения в БД.
            self.set("history", history)

        except Exception:
            # Ошибка одного сообщения не должна
            # останавливать весь модуль.
            return

    # ========================================================
    # РЕДАКТИРОВАНИЕ СООБЩЕНИЙ
    # ========================================================

    @loader.watcher()
    async def edited_watcher(self, message):
        """
        Обрабатывает редактирование сообщения.

        Например:

            Было:  Привет
            Стало: Привет, как дела?

        В архиве до этого лежало "Привет".
        Поэтому мы можем сохранить обе версии.
        """

        try:
            if message.chat_id is None:
                return

            chat_id = str(message.chat_id)

            if chat_id not in self.get_watched():
                return

            history = self.get_history()

            if chat_id not in history:
                return

            message_id = str(message.id)

            # Старая версия сообщения.
            old = history[chat_id].get(message_id)

            # Если старой версии нет,
            # мы не можем узнать, что было раньше.
            if not old:
                return

            old_text = old.get("text", "")

            # Новая версия.
            new_text = message.raw_text or ""

            # Если текст не изменился — ничего не делаем.
            if old_text == new_text:
                return

            # Получаем журнал изменений.
            changes = self.get_changes()

            if chat_id not in changes:
                changes[chat_id] = {
                    "deleted": [],
                    "edited": [],
                }

            # Записываем изменение.
            changes[chat_id]["edited"].append({
                # ID сообщения.
                "id": message.id,

                # Автор.
                "sender": old.get(
                    "sender",
                    "Неизвестный",
                ),

                # Старая версия.
                "old": old_text,

                # Новая версия.
                "new": new_text,

                # Время редактирования.
                "date": (
                    message.edit_date.timestamp()
                    if message.edit_date
                    else datetime.now().timestamp()
                ),
            })

            # В основной истории оставляем уже новую версию.
            history[chat_id][message_id][
                "text"
            ] = new_text

            self.set("history", history)
            self.set("changes", changes)

        except Exception:
            return

    # ========================================================
    # RAW TELEGRAM UPDATE
    # ========================================================

    @loader.raw_handler(
        types.UpdateDeleteMessages,
        types.UpdateDeleteChannelMessages,
    )
    async def delete_handler(self, update):
        """
        Получает raw Telegram updates об удалении сообщений.

        Telegram сообщает нам ID удалённого сообщения,
        но самого текста уже не присылает.

        Поэтому:

            Telegram:
                "ID 123 удалён"

        Мы смотрим в собственный архив:

            ID 123 → "Привет"

        И записываем "Привет" в журнал удалений.
        """

        try:

            # =================================================
            # ОБЫЧНЫЕ ЧАТЫ
            # =================================================

            if isinstance(
                update,
                types.UpdateDeleteMessages,
            ):

                deleted_ids = update.messages

                # У этого типа update обычно нет chat_id.
                #
                # Поэтому ищем каждый ID среди всех
                # отслеживаемых чатов.
                #

                await self.process_deleted(
                    deleted_ids
                )

                return

            # =================================================
            # КАНАЛЫ / СУПЕРГРУППЫ
            # =================================================

            if isinstance(
                update,
                types.UpdateDeleteChannelMessages,
            ):

                deleted_ids = update.messages

                # ID канала.
                channel_id = update.channel_id

                # Telegram использует специальный формат
                # chat_id для каналов:
                #
                # -100XXXXXXXXXX
                #

                chat_id = str(
                    -1000000000000
                    - channel_id
                )

                # Если чат не отслеживается —
                # игнорируем удаление.
                if chat_id not in self.get_watched():
                    return

                await self.process_deleted(
                    deleted_ids,
                    chat_id,
                )

        except Exception:
            return

    # ========================================================
    # ОБРАБОТКА УДАЛЁННЫХ СООБЩЕНИЙ
    # ========================================================

    async def process_deleted(
        self,
        deleted_ids,
        known_chat_id=None,
    ):
        """
        Ищет удалённые сообщения в нашем архиве.

        known_chat_id:
            Если Telegram уже сообщил, из какого чата
            пришло удаление.

        Если known_chat_id неизвестен, функция ищет ID
        сообщения среди всех отслеживаемых чатов.
        """

        history = self.get_history()
        changes = self.get_changes()
        watched = self.get_watched()

        # ----------------------------------------------------
        # ЕСЛИ ЧАТ УЖЕ ИЗВЕСТЕН
        # ----------------------------------------------------

        if known_chat_id is not None:

            chat_ids = [known_chat_id]

        # ----------------------------------------------------
        # ЕСЛИ ЧАТ НЕИЗВЕСТЕН
        # ----------------------------------------------------

        else:

            chat_ids = []

            for chat_id in watched:

                if chat_id not in history:
                    continue

                for message_id in deleted_ids:

                    if str(message_id) in history[
                        chat_id
                    ]:

                        chat_ids.append(chat_id)
                        break

            # Если не нашли ни одного сообщения —
            # значит его не было в архиве.
            if not chat_ids:
                return

        # ----------------------------------------------------
        # ОБРАБАТЫВАЕМ НАЙДЕННЫЕ СООБЩЕНИЯ
        # ----------------------------------------------------

        for chat_id in chat_ids:

            if chat_id not in history:
                continue

            if chat_id not in changes:
                changes[chat_id] = {
                    "deleted": [],
                    "edited": [],
                }

            for message_id in deleted_ids:

                message_id = str(message_id)

                old = history[
                    chat_id
                ].get(message_id)

                # Сообщение не было сохранено.
                if not old:
                    continue

                # Сохраняем его в журнал удалений.
                changes[chat_id][
                    "deleted"
                ].append({
                    "id": old["id"],
                    "sender": old["sender"],
                    "text": old["text"],
                    "date": old["date"],
                })

                # Удаляем сообщение из текущей истории.
                del history[
                    chat_id
                ][message_id]

        self.set("history", history)
        self.set("changes", changes)

    # ========================================================
    # .addwtch
    # ========================================================

    @loader.command()
    async def addwtchcmd(self, message):
        """
        .addwtch

        Начинает отслеживание текущего чата.

        Важно:
        сообщения ДО этой команды не попадут в архив.
        """

        chat_id = str(message.chat_id)

        watched = self.get_watched()

        # Уже отслеживается?
        if chat_id in watched:

            await utils.answer(
                message,
                "👁️ <b>Этот чат уже отслеживается.</b>",
            )

            return

        # Добавляем чат.
        watched.append(chat_id)

        self.set("watched", watched)

        # Создаём историю.
        history = self.get_history()

        if chat_id not in history:
            history[chat_id] = {}

        self.set("history", history)

        # Создаём журнал изменений.
        changes = self.get_changes()

        if chat_id not in changes:
            changes[chat_id] = {
                "deleted": [],
                "edited": [],
            }

        self.set("changes", changes)

        await utils.answer(
            message,
            (
                "👁️ <b>Отслеживание включено.</b>\n\n"
                "С этого момента сообщения этого чата "
                "будут сохраняться."
            ),
        )

    # ========================================================
    # .delwtch
    # ========================================================

    @loader.command()
    async def delwtchcmd(self, message):
        """
        .delwtch

        Выключает отслеживание текущего чата.

        Уже сохранённая история НЕ удаляется.
        """

        chat_id = str(message.chat_id)

        watched = self.get_watched()

        if chat_id not in watched:

            await utils.answer(
                message,
                "❌ <b>Этот чат не отслеживается.</b>",
            )

            return

        watched.remove(chat_id)

        self.set("watched", watched)

        await utils.answer(
            message,
            (
                "⛔ <b>Отслеживание отключено.</b>\n\n"
                "Старая история сохранена."
            ),
        )

    # ========================================================
    # .wtchlist
    # ========================================================

    @loader.command()
    async def wtchlistcmd(self, message):
        """
        .wtchlist

        Показывает:

        🗑 удалённые сообщения

        ✏️ отредактированные сообщения
        """

        chat_id = str(message.chat_id)

        if chat_id not in self.get_watched():

            await utils.answer(
                message,
                (
                    "❌ <b>Этот чат не отслеживается.</b>\n"
                    "Используй <code>.addwtch</code>."
                ),
            )

            return

        changes = self.get_changes()

        data = changes.get(
            chat_id,
            {
                "deleted": [],
                "edited": [],
            },
        )

        deleted = data["deleted"]
        edited = data["edited"]

        # Нет изменений.
        if not deleted and not edited:

            await utils.answer(
                message,
                "✅ <b>Изменений не обнаружено.</b>",
            )

            return

        result = "👁️ <b>Журнал изменений</b>\n"

        # ----------------------------------------------------
        # УДАЛЁННЫЕ
        # ----------------------------------------------------

        if deleted:

            result += "\n🗑 <b>Удалено:</b>\n"

            for item in deleted[
                -self.MAX_CHANGES:
            ]:

                time = datetime.fromtimestamp(
                    item["date"]
                ).strftime("%H:%M:%S")

                sender = utils.escape_html(
                    item["sender"]
                )

                text = utils.escape_html(
                    item["text"]
                    or "[медиа/без текста]"
                )

                result += (
                    f"\n• <code>{time}</code> — "
                    f"<b>{sender}</b>\n"
                    f"  <blockquote>"
                    f"{text}"
                    f"</blockquote>"
                )

        # ----------------------------------------------------
        # ИЗМЕНЁННЫЕ
        # ----------------------------------------------------

        if edited:

            result += "\n\n✏️ <b>Изменено:</b>\n"

            for item in edited[
                -self.MAX_CHANGES:
            ]:

                time = datetime.fromtimestamp(
                    item["date"]
                ).strftime("%H:%M:%S")

                sender = utils.escape_html(
                    item["sender"]
                )

                old = utils.escape_html(
                    item["old"]
                    or "[медиа/без текста]"
                )

                new = utils.escape_html(
                    item["new"]
                    or "[медиа/без текста]"
                )

                result += (
                    f"\n• <code>{time}</code> — "
                    f"<b>{sender}</b>\n"
                    f"  <b>Было:</b>\n"
                    f"  <blockquote>{old}</blockquote>\n"
                    f"  <b>Стало:</b>\n"
                    f"  <blockquote>{new}</blockquote>"
                )

        # Если результат слишком большой,
        # Telegram может его не принять.
        #
        # Поэтому просто обрезаем отображение.
        #

        if len(result) > 4000:
            result = (
                result[:3900]
                + "\n\n<i>...список обрезан.</i>"
            )

        await utils.answer(
            message,
            result,
        )

    # ========================================================
    # .wtchhstry
    # ========================================================

    @loader.command()
    async def wtchhstrycmd(self, message):
        """
        .wtchhstry

        Показывает сохранённую историю текущего чата.
        """

        chat_id = str(message.chat_id)

        if chat_id not in self.get_watched():

            await utils.answer(
                message,
                (
                    "❌ <b>Этот чат не отслеживается.</b>\n"
                    "Используй <code>.addwtch</code>."
                ),
            )

            return

        history = self.get_history()

        messages = history.get(
            chat_id,
            {},
        )

        if not messages:

            await utils.answer(
                message,
                "📭 <b>История пока пустая.</b>",
            )

            return

        # Превращаем словарь сообщений в список.
        items = list(
            messages.values()
        )

        # Сортируем по времени.
        items.sort(
            key=lambda x: x.get("date", 0)
        )

        result = "📜 <b>История сообщений</b>\n"

        for item in items:

            time = datetime.fromtimestamp(
                item["date"]
            ).strftime("%H:%M:%S")

            sender = utils.escape_html(
                item["sender"]
            )

            text = utils.escape_html(
                item["text"]
                or "[медиа/без текста]"
            )

            result += (
                f"\n<code>[{time}]</code> "
                f"<b>{sender}</b>: "
                f"{text}"
            )

        # ----------------------------------------------------
        # TELEGRAM ЛИМИТИРУЕТ ДЛИНУ СООБЩЕНИЯ
        # ----------------------------------------------------

        # Если история слишком длинная,
        # отправляем её кусками.
        #

        while len(result) > 3500:

            position = result.rfind(
                "\n",
                0,
                3500,
            )

            if position == -1:
                position = 3500

            chunk = result[:position]

            result = result[position:]

            await self.client.send_message(
                message.chat_id,
                chunk,
                parse_mode="html",
            )

        if result:

            await self.client.send_message(
                message.chat_id,
                result,
                parse_mode="html",
            )

        # Удаляем команду .wtchhstry.
        try:
            await message.delete()
        except Exception:
            pass

    # ========================================================
    # .wtchclear
    # ========================================================

    @loader.command()
    async def wtchclearcmd(self, message):
        """
        .wtchclear

        Очищает журнал удалённых и изменённых сообщений.

        Сама история сообщений остаётся.
        """

        chat_id = str(message.chat_id)

        if chat_id not in self.get_watched():

            await utils.answer(
                message,
                "❌ <b>Этот чат не отслеживается.</b>",
            )

            return

        changes = self.get_changes()

        changes[chat_id] = {
            "deleted": [],
            "edited": [],
        }

        self.set("changes", changes)

        await utils.answer(
            message,
            (
                "🧹 <b>Журнал изменений очищен.</b>\n\n"
                "📜 История сообщений сохранена."
            ),
        )
