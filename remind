from .. import utils, loader
import asyncio


@loader.tds
class ReminderBot(loader.Module):
    """Модуль для напоминаний через инлайн - бота"""
    strings = {
        "name": "ReminderBot",
        "nosave": "Nothing is saved!",
        "nonesave": "Nothing to save!",
        "noint": "Incorrect number!",
        "save_success": "Saved successfully!",
        "on": "Turned on reminder!",
        "nostat": "Reminder is off!",
        "stop_success": "Stopped reminder!",
        "toolow": "Time is too low!",
        "error": "Error occured, please contact the developer! (@friendsforeveruwu)"
    }

    def __init__(self):
        self.config = loader.ModuleConfig(
            loader.ConfigValue(
                "Min_time",
                10,
                "Ограничение минимального времени",
                validator=loader.validators.Integer(minimum=1)
            )
        )

    async def client_ready(self, client, db):
        self.client = client
        self.me = await client.get_me()
        self.running = False


    @loader.command()
    async def setreminder(self, message):
        """Установить напоминание
        setreminder время текст
        s,sec - в секундах, h,hour,hours - в часах, d,day,days - в днях"""
        
        try:
            args = utils.get_args(message)
            if not args:
                await utils.answer(message, self.strings["nonesave"])
                return
            time = args[0]

            if not time:
                await utils.answer(message, self.strings["nonesave"])
                return

            elif time.endswith("s"):
                time = time[:-1]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["nonint"])
                    return

            elif time.endswith("m"):
                time = time[:-1]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 60

            elif time.endswith("min"):
                time = time[:-3]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 60

            elif time.endswith("mins"):
                time = time[:-4]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 60

            elif time.endswith("h"):
                time = time[:-1]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 3600

            elif time.endswith("hour"):
                time = time[:-4]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 3600

            elif time.endswith("hours"):
                time = time[:-5]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 3600

            elif time.endswith("d"):
                time = time[:-1]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 86400

            elif time.endswith("days"):
                time = time[:-4]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 86400

            elif time.endswith("day"):
                time = time[:-3]
                try:
                    time = int(time)
                except ValueError:
                    await utils.answer(message, self.strings["noint"])
                    return
                time = time * 86400

            else:
                await utils.answer(message, self.strings["nonesave"])
                return

            reminder = " ".join(args[1:])
            if time < self.config["Min_time"]:
                await utils.answer(message, self.strings["toolow"])
                return
            elif not reminder:
                await utils.answer(message, self.strings["nosave"])
                return
            else:
                self.db.set(self.strings["name"], "reminder", reminder)
                self.db.set(self.strings["name"], "time", time)
                await utils.answer(message, self.strings["save_success"])
        except Exception:
            await utils.answer(message, self.strings["error"])


    @loader.command()
    async def start(self, message):
        """Включить напоминания"""
        try:
            reminder = self.db.get(self.strings["name"], "reminder")
            time = self.db.get(self.strings["name"], "time")
            if not reminder:
                await utils.answer(message, self.strings["nosave"])
            elif not time:
                await utils.answer(message, self.strings["nonesave"])
            else:
                self.running = True
                asyncio.create_task(self._loop())
                await utils.answer(message, self.strings["on"])
        except Exception:
            await utils.answer(message, self.strings["error"])

    async def _loop(self):
        try:
            while self.running:
                reminder = self.db.get(self.strings["name"], "reminder")
                time = self.db.get(self.strings["name"], "time")
                if not time:
                    self.running = False
                    return
                elif not reminder:
                    self.running = False
                    return
                else:
                    await self.inline.bot.send_message(self.me.id, reminder)
                    await asyncio.sleep(time)
        except Exception:
            await self.inline.bot.send_message(self.me.id, self.strings["error"])
            self.running = False

    @loader.command()
    async def stop(self, message):
        """Выключить напоминания"""
        try:
            if not self.running:
                await utils.answer(message, self.strings["nostat"])
            else:
                await utils.answer(message, self.strings["stop_success"])
                self.running = False
        except Exception:
            await utils.answer(message, self.strings["error"])

    @loader.command()
    async def reset(self, message):
        """Исключительно для разработчика. Игнорьте"""
        self.running = False
        time = 0
        reminder = None
        await utils.answer(message, "Good bro!")

    @loader.command()
    async def showper(self, message):
        """исключительно для разраба. Игнорьте"""
        reminder = self.db.get(self.strings["name"], "reminder")
        time = self.db.get(self.strings["name"], "time")
        await utils.answer(message, f"Время - {time}, текст - {reminder}, работа - {self.running}")
