# meta developer: @hmodule

# scope: hikka_only

import logging
import asyncio
import functools
import html
from collections import defaultdict

from openai import OpenAI

from .. import loader, utils
from telethon.tl.types import Message, User


logger = logging.getLogger(__name__)


STATIC_EMOJIS = {
    "q": "❓",
    "brain": "🧠",
    "bulb": "💡",
    "cross": "❌",
    "tick": "✅",
    "broom": "🧹",
}


ANIMATED_EMOJIS = {
    "q": "😘",
    "brain": "😔",
    "bulb": "🤔",
    "cross": "❌",
    "tick": "✅",
    "broom": "🧹",
}


MEMORY_DEPTH = 10


@loader.tds
class G4fAskMod(loader.Module):
    """
    AI модуль для Hikka через собственные API
    Поддерживает OpenAI, DeepSeek, Gemini, OpenRouter
    """

    strings = {
        "name": "G4fAsk",

        "no_args_ai":
            "{q} Использование: .ai <провайдер>\n"
            "Доступные: {available}\n"
            "Текущий: {current}",

        "invalid_ai":
            "{cross} Неизвестный провайдер. Доступно: {available}",

        "ai_changed":
            "{tick} Выбран AI: {ai}",

        "no_key":
            "{cross} Для {ai} не найден API ключ.",

        "no_args_ask":
            "{q} Напиши вопрос.",

        "thinking":
            "{brain} Думаю через {ai}...",

        "result":
            "{q} Вопрос:\n{prompt}\n\n"
            "{bulb} Ответ ({ai}):\n{answer}",

        "error":
            "{cross} Ошибка:\n{error}",

        "cleared":
            "{broom} История очищена.",

        "no_history":
            "{broom} История отсутствует.",
    }


    strings_ru = {
        "_cls_doc":
            "AI ассистент через собственные API ключи",

        "_cmd_doc_ai":
            "<провайдер> - выбрать AI",

        "_cmd_doc_ask":
            "<текст> - спросить AI",

        "_cmd_doc_clearchat":
            "Очистить память AI",
    }


    def __init__(self):

        self.config = loader.ModuleConfig(

            loader.ConfigValue(
                "openai_key",
                None,
                lambda: "OpenAI API ключ"
            ),

            loader.ConfigValue(
                "deepseek_key",
                None,
                lambda: "DeepSeek API ключ"
            ),

            loader.ConfigValue(
                "gemini_key",
                None,
                lambda: "Gemini API ключ"
            ),

            loader.ConfigValue(
                "openrouter_key",
                None,
                lambda: "OpenRouter API ключ"
            ),
        )


        self._chat_history = defaultdict(list)

        self.clients = {}

        self.providers = {}
    async def client_ready(self, client, db):

        self.db = db


        self.providers = {

            "openai": {
                "model": "gpt-4.1-mini",
                "url": "https://api.openai.com/v1",
                "key": self.config["openai_key"],
            },


            "deepseek": {
                "model": "deepseek-chat",
                "url": "https://api.deepseek.com",
                "key": self.config["deepseek_key"],
            },


            "gemini": {
                "model": "gemini-2.0-flash",
                "url":
                "https://generativelanguage.googleapis.com/v1beta/openai/",
                "key": self.config["gemini_key"],
            },


            "openrouter": {
                "model":
                "google/gemini-2.5-flash",
                "url":
                "https://openrouter.ai/api/v1",
                "key": self.config["openrouter_key"],
            },
        }


        for name, data in self.providers.items():

            if data["key"]:

                try:
                    self.clients[name] = OpenAI(
                        api_key=data["key"],
                        base_url=data["url"]
                    )

                    logger.info(
                        f"Loaded AI provider: {name}"
                    )

                except Exception as e:
                    logger.error(
                        f"Failed loading {name}: {e}"
                    )


        if not self.db.get(
            "G4fAskMod",
            "provider",
            None
        ):

            self.db.set(
                "G4fAskMod",
                "provider",
                "openai"
            )



    def _get_emojis(self, user: User):

        if getattr(
            user,
            "premium",
            False
        ):
            return ANIMATED_EMOJIS

        return STATIC_EMOJIS



    async def _answer(
        self,
        message,
        text,
        **kwargs
    ):

        emojis = kwargs.pop(
            "emojis",
            {}
        )

        text = text.format(
            **kwargs,
            **emojis
        )

        return await utils.answer(
            message,
            text,
            parse_mode="html"
        )



    async def _answer_result(
        self,
        message,
        text,
        prompt,
        answer,
        **kwargs
    ):

        emojis = kwargs.pop(
            "emojis",
            {}
        )

        text = text.format(

            prompt=html.escape(
                prompt
            ),

            answer=html.escape(
                answer
            ),

            **kwargs,
            **emojis
        )


        return await utils.answer(
            message,
            text,
            parse_mode="html"
        )



    def _save_history(
        self,
        chat_id
    ):

        history = list(
            self._chat_history[chat_id]
        )


        while len(history) > MEMORY_DEPTH * 2:
            history.pop(0)


        self._chat_history[chat_id] = history



    def _get_provider(self):

        return self.db.get(
            "G4fAskMod",
            "provider",
            "openai"
        )
    @loader.command(
        ru_doc="<провайдер> - выбрать AI",
        en_doc="<provider> - select AI",
        aliases=["setai"],
    )
    async def ai(self, message: Message):
        """
        Выбор AI провайдера
        """

        sender = await message.get_sender()

        emojis = self._get_emojis(sender)

        args = utils.get_args_raw(message).lower().strip()


        available = ", ".join(
            self.providers.keys()
        )


        if not args:

            current = self._get_provider()

            await self._answer(
                message,
                self.strings("no_args_ai"),
                available=available,
                current=current,
                emojis=emojis
            )

            return



        if args not in self.providers:

            await self._answer(
                message,
                self.strings("invalid_ai"),
                available=available,
                emojis=emojis
            )

            return



        self.db.set(
            "G4fAskMod",
            "provider",
            args
        )


        await self._answer(
            message,
            self.strings("ai_changed"),
            ai=args,
            emojis=emojis
        )



    @loader.command(
        ru_doc="<текст> - спросить AI",
        en_doc="<text> - ask AI",
        aliases=["a"],
    )
    async def ask(
        self,
        message: Message
    ):

        sender = await message.get_sender()

        emojis = self._get_emojis(sender)


        prompt = utils.get_args_raw(message)


        if not prompt:

            await self._answer(
                message,
                self.strings("no_args_ask"),
                emojis=emojis
            )

            return



        provider = self._get_provider()


        if provider not in self.clients:

            await self._answer(
                message,
                self.strings("no_key"),
                ai=provider,
                emojis=emojis
            )

            return



        client = self.clients[provider]


        data = self.providers[provider]


        model = data["model"]



        msg = await self._answer(
            message,
            self.strings("thinking"),
            ai=provider,
            emojis=emojis
        )


        history = list(
            self._chat_history[
                message.chat_id
            ]
        )


        messages = history + [
            {
                "role": "user",
                "content": prompt
            }
        ]



        try:

            response = await asyncio.get_event_loop().run_in_executor(

                None,

                functools.partial(

                    client.chat.completions.create,

                    model=model,

                    messages=messages

                )

            )


            answer = (
                response
                .choices[0]
                .message
                .content
            )



            self._chat_history[
                message.chat_id
            ].append(

                {
                    "role": "user",
                    "content": prompt
                }

            )


            self._chat_history[
                message.chat_id
            ].append(

                {
                    "role": "assistant",
                    "content": answer
                }

            )


            self._save_history(
                message.chat_id
            )



            await self._answer_result(

                msg,

                self.strings("result"),

                prompt,

                answer,

                ai=provider,

                emojis=emojis

            )



        except Exception as e:


            logger.exception(
                "AI request error"
            )


            await self._answer(
                msg,
                self.strings("error"),
                error=html.escape(
                    str(e)
                ),
                emojis=emojis
            )




    @loader.command(
        ru_doc="Очистить память AI",
        en_doc="Clear AI memory",
    )
    async def clearchat(
        self,
        message: Message
    ):

        sender = await message.get_sender()

        emojis = self._get_emojis(sender)


        chat_id = message.chat_id


        if chat_id in self._chat_history:

            del self._chat_history[chat_id]


            await self._answer(
                message,
                self.strings("cleared"),
                emojis=emojis
            )


        else:

            await self._answer(
                message,
                self.strings("no_history"),
                emojis=emojis
            )
