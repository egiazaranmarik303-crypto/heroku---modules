from .. import loader, utils


@loader.tds
class TestLoop(loader.Module):

    @loader.loop(interval=3, autostart=False)
    async def my_loop(self):
        await self.client.send_message(self.chat_id, "РРРРР")

    @loader.command()
    async def start(self, message):
        self.chat_id = message.chat_id
        self.my_loop.start()
        await message.edit("Loop запущен!")

    @loader.command()
    async def stop(self, message):
        self.my_loop.stop()
        await message.edit("Loop остановлен!")

