from .. import loader, utils
@loader.tds
class Module(loader.Module):
    '''MyModule'''
    strings = {
        "name": "MyModule",
        "no_un": "No saved UserName!"
    }

    async def client_ready(self,client,db):
        self.client = client

    @loader.command()
    async def setfriend(self,message):
        friend = utils.get_args_raw(message)
        if not "@" in friend:
            await utils.answer(message,self.strings["no_un"])
        else:
            friend = friend.lstrip("@")
            self.db.set(self.strings["name"],"saved_un", friend)

    @loader.command()
    async def friendcheck(self,message):
        friend = self.db.get(self.strings["name"],"saved_un")
        if not friend:
            await utils.answer(message,self.strings["no_un"])
        else:
            text = utils.get_args_raw(message)
            await self.client.send_message(friend, text)
