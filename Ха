from .. import loader, utils
class MyModule(loader.Module):
    ""my first module""
    strings = {
        "name": "module"
    }

    @loader.command()
    async def say(self,message):
        arg = utils.get_args(message)
        if not arg:
            await utils.answer(message,"Пустой!")
        else:
            await utils.answer(message, arg)
